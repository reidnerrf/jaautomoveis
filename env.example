# Configurações da Aplicação JA Automóveis
# ======================================

# Ambiente
NODE_ENV=production

# JWT Secret (IMPORTANTE: Altere em produção)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Banco de Dados MongoDB
MONGODB_URI=mongodb://mongo:27017/JaAutomoveis

# Porta do servidor
PORT=5000

# CORS - Origens permitidas
ALLOWED_ORIGINS=http://localhost,https://localhost,http://localhost:5000,http://127.0.0.1,https://127.0.0.1

# Configurações de Email (opcional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@jaautomoveis.com

# Redis (opcional - para cache)
REDIS_URL=redis://localhost:6379

# Configurações de Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Configurações de SSL (para produção)
SSL_CERT_PATH=./ssl/cert.pem
SSL_KEY_PATH=./ssl/key.pem

# Configurações de Log
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Configurações de Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Configurações de Segurança
BCRYPT_ROUNDS=12
SESSION_SECRET=your-session-secret-change-this

# Configurações de Desenvolvimento
SKIP_DB=false
DEBUG=false
