# Habilita/Desabilita o banner promocional (1=on, 0=off)
VITE_PROMO_ENABLED=1

# Valores padrão do banner (usados quando não houver override por página)
VITE_PROMO_MESSAGE=Semana de Ofertas: bônus na avaliação do seu usado!
VITE_PROMO_CTA_LABEL=Ver Estoque
VITE_PROMO_CTA_HREF=/inventory

# Overrides por rota (JSON). Usa o primeiro match ou o prefixo mais longo.
# Home ("/"), Estoque ("/inventory"), Financiamento ("/financing")
VITE_PROMO_OVERRIDES={
  "/": {"message": "Bem-vindo! Ofertas especiais hoje", "ctaLabel": "Ver ofertas", "ctaHref": "/inventory?promo=home"},
  "/inventory": {"message": "Queima de estoque! Até 10% off", "ctaLabel": "Ver promoções", "ctaHref": "/inventory?promo=clearance"},
  "/financing": {"message": "Taxas reduzidas de financiamento", "ctaLabel": "Simular agora", "ctaHref": "/financing"}
}

